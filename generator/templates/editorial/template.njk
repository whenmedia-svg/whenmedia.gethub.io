{% extends "_shared/base.njk" %}
{% import "_shared/social.njk" as social %}
{% import "_shared/work.njk" as work %}
{% import "_shared/footer.njk" as footer %}

{% block page %}

<header class="topbar">
  <div class="container topbar-inner">
    <p class="topbar-name">{{ site.name }}</p>
    <div class="topbar-right">
      {% if site.resume %}<a class="resume-link" href="{{ site.resume }}" target="_blank" rel="noopener">Resume</a>{% endif %}
      {{ social.socialLinks(site.socials) }}
    </div>
  </div>
</header>

<section class="hero">
  <div class="container">
    <h1 class="hero-title">{{ site.tagline or site.name }}</h1>
    {% if site.nav.length %}
      <nav class="hero-nav" aria-label="Sections">
        {% for item in site.nav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
      </nav>
    {% endif %}
  </div>
</section>

{% if site.hasAbout or site.banner %}
  <section id="about" class="about-section">
    <div class="container">
      <div class="row g-5 align-items-center">
        {% if site.banner %}
          <div class="col-md-5"><img class="about-photo" src="{{ site.banner }}" alt="{{ site.name }}"></div>
        {% endif %}
        {% if site.hasAbout %}
          <div class="{% if site.banner %}col-md-7{% else %}col-lg-8 mx-auto{% endif %}">
            <h2 class="section-heading">About</h2>
            {% for p in site.bio %}<p class="about-p">{{ p }}</p>{% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% if site.hasWork %}
  <div class="works-band">
    {{ work.rowSections(site.categories) }}
  </div>
{% endif %}

{{ footer.contactSection(site) }}
{{ footer.siteFooter(site) }}

{% endblock %}
