{% extends "_shared/base.njk" %}
{% import "_shared/social.njk" as social %}
{% import "_shared/work.njk" as work %}
{% import "_shared/footer.njk" as footer %}

{% block page %}
<div class="layout">

  <aside class="sidebar">
    {% if site.banner %}
      <img class="sidebar-photo" src="{{ site.banner }}" alt="{{ site.name }}">
    {% endif %}
    {{ social.socialLinks(site.socials) }}
    <p class="sidebar-name">{{ site.name }}</p>
    {% if site.hasAbout %}
      <div class="sidebar-bio" id="about">
        {% for p in site.bio %}<p>{{ p }}</p>{% endfor %}
      </div>
    {% endif %}
    {% if site.nav.length or site.resume %}
      <nav class="sidebar-nav" aria-label="Sections">
        {% for item in site.nav %}<a href="{{ item.href }}">{{ item.label }}</a>{% endfor %}
        {% if site.resume %}<a href="{{ site.resume }}" target="_blank" rel="noopener">Resume</a>{% endif %}
      </nav>
    {% endif %}
  </aside>

  <main class="main">

    <header class="masthead">
      <div class="container">
        <h1 class="masthead-title">{{ site.tagline or site.name }}</h1>
      </div>
    </header>

    {# The bio lives in the sidebar, so #about anchors there on wide screens.
       On narrow screens the sidebar stacks above, so the link still works. #}

    {% if site.hasWork %}
      {{ work.cardSections(site.categories, cols=3) }}
    {% endif %}

    {{ footer.contactSection(site) }}
    {{ footer.siteFooter(site) }}
  </main>

</div>
{% endblock %}
